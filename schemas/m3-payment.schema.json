{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mandate.wallet/schemas/m3-payment-v2.json",
  "title": "M3 payment record v2 (integer strings; contract/SDK perform range and authority checks)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "wallet",
    "asset",
    "payment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "chainId": {
      "type": "integer",
      "enum": [
        31337,
        11155111,
        84532,
        8453
      ]
    },
    "wallet": {
      "$ref": "#/definitions/address"
    },
    "asset": {
      "$ref": "#/definitions/address"
    },
    "payment": {
      "$ref": "#/definitions/payment"
    }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandateId",
        "sessionId",
        "stepId",
        "merchantId",
        "requestHash",
        "quoteHash",
        "nonce",
        "policyVersion",
        "sessionEpoch",
        "value",
        "validAfter",
        "validBefore",
        "to"
      ],
      "properties": {
        "mandateId": {
          "$ref": "#/definitions/hash"
        },
        "sessionId": {
          "$ref": "#/definitions/hash"
        },
        "stepId": {
          "$ref": "#/definitions/hash"
        },
        "merchantId": {
          "$ref": "#/definitions/hash"
        },
        "requestHash": {
          "$ref": "#/definitions/hash"
        },
        "quoteHash": {
          "$ref": "#/definitions/hash"
        },
        "nonce": {
          "$ref": "#/definitions/hash"
        },
        "policyVersion": {
          "$ref": "#/definitions/uint"
        },
        "sessionEpoch": {
          "$ref": "#/definitions/uint"
        },
        "value": {
          "$ref": "#/definitions/uint"
        },
        "validAfter": {
          "$ref": "#/definitions/uint"
        },
        "validBefore": {
          "$ref": "#/definitions/uint"
        },
        "to": {
          "$ref": "#/definitions/address"
        }
      }
    }
  }
}
