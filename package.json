{
  "name": "mandate-m1-experiments",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:upstream": "pnpm --filter @x402/core build && pnpm --filter @x402/evm build",
    "build": "forge build --root contracts && pnpm build:upstream && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "forge test --root contracts --fuzz-seed 0x4022026 --fuzz-runs 10000",
    "demo:local": "tsx experiments/local.ts",
    "demo:sepolia": "tsx experiments/sepolia.ts",
    "evidence:sepolia": "tsx experiments/public-evidence.ts",
    "probe": "tsx experiments/probe.ts",
    "prep:resources": "tsx experiments/resource-inventory.ts",
    "compare:accounts": "tsx experiments/compare-accounts.ts",
    "setup:test-accounts": "tsx experiments/create-test-config.ts",
    "fund:testnet": "tsx experiments/fund-testnet.ts",
    "verify:sources": "python3 scripts/verify-sources.py",
    "m2:bootstrap": "python3 scripts/bootstrap-m2.py",
    "m2:build:contracts": "forge build --quiet --root echo/contracts",
    "m2:build:alto": "python3 scripts/m2-build-alto.py",
    "m2:test": "vitest run --config echo/gateway/vitest.config.ts",
    "m2:test:contracts": "forge test --root echo/contracts",
    "m2:infra": "python3 scripts/m2-infra.py",
    "m2:ready": "tsx echo/experiments/readiness.ts",
    "m2:fund": "tsx echo/experiments/fund-public.ts",
    "m2:deploy": "tsx echo/experiments/deploy-public.ts",
    "m2:accept": "tsx echo/experiments/run-public.ts",
    "m2:gateway": "tsx echo/gateway/src/cli.ts",
    "m2:verify:sources": "python3 scripts/verify-m2-sources.py",
    "m2:regress:base": "tsx echo/experiments/base-regression.ts",
    "m2:workflow": "python3 scripts/m2-public-workflow.py",
    "m2:verify:public": "python3 scripts/m2-verify-public.py",
    "m2:evidence": "tsx echo/experiments/public-evidence.ts",
    "m3:build:contracts": "forge build --root mandate/contracts",
    "m3:abi": "python3 scripts/m3-export-abi.py",
    "m3:test:contracts": "forge test --root mandate/contracts",
    "m3:test": "vitest run --config mandate/sdk/vitest.config.ts",
    "m3:probe": "tsx mandate/experiments/probe-networks.ts",
    "m3:deploy": "tsx mandate/experiments/deploy-public.ts",
    "m3:accept": "tsx mandate/experiments/accept-public.ts",
    "m3:evidence": "tsx mandate/experiments/public-evidence.ts",
    "m3:verify:runtime": "tsx mandate/experiments/verify-runtime.ts",
    "m3:workflow": "python3 scripts/m3-public-workflow.py",
    "m4:test": "vitest run --config mandate/services/vitest.config.ts",
    "m4:bazaar": "tsx mandate/experiments/probe-bazaar.ts",
    "m4:resources": "tsx mandate/experiments/m4-resources.ts",
    "m4:gateway": "tsx mandate/gateway/cli.ts",
    "m4:accept": "tsx mandate/experiments/m4-public.ts",
    "m4:host-configs": "node --import tsx mandate/experiments/m4-host-configs.ts",
    "m4:serve": "tsx mandate/experiments/m4-serve.ts",
    "m4:build": "node scripts/m4-build-gateway.mjs",
    "m4:accept:hosts": "python3 scripts/m4-accept-hosts.py",
    "m5:test": "vitest run --config mandate/evidence/vitest.config.ts",
    "m5:accept:foundation": "python3 scripts/m5-accept-foundation.py",
    "m5:build:verifier": "node scripts/m5-build-verifier.mjs",
    "m5:verify": "node dist/mandate-evidence-verifier.js",
    "m5:resources": "node --import tsx mandate/experiments/m5-resources.ts",
    "m5:accept:public": "node --import tsx mandate/experiments/m5-public.ts",
    "m5:controller": "node --import tsx mandate/evidence/controller-cli.ts",
    "m5:observe:public": "node --import tsx mandate/experiments/m5-controller.ts",
    "m5:accept:interference": "python3 scripts/m5-accept-interference.py",
    "m5:tlsnotary:bootstrap": "python3 scripts/m5-tlsnotary-bootstrap.py",
    "m5:tlsnotary:run": "python3 scripts/m5-tlsnotary-run.py",
    "m6:build": "node scripts/m6-build-web.mjs",
    "m6:test": "vitest run --config mandate/web/vitest.config.ts",
    "m6:observe:public": "node --import tsx mandate/experiments/m6-observe-public.ts",
    "m7:test": "vitest run --config mandate/operations/vitest.config.ts",
    "m7:monitor": "node --import tsx mandate/operations/cli.ts",
    "m7:fuzz": "node --import tsx mandate/research/invalid-calls.ts",
    "m7:audit:dataset": "python3 scripts/m7-audit-dataset.py",
    "m7:bench:echo": "node --import tsx mandate/research/echo-baseline.ts",
    "m7:bench:http": "node --import tsx mandate/research/http-baselines.ts",
    "m7:bench:stateful": "node --import tsx mandate/research/stateful-attacks.ts",
    "m7:audit:benchmarks": "python3 scripts/m7-audit-benchmarks.py",
    "m6:serve": "node --import tsx mandate/web/cli.ts",
    "sdk:bootstrap": "python3 scripts/bootstrap-sdk.py",
    "sdk:cli": "node --import tsx mandate/sdk/cli.ts",
    "sdk:demo": "node --import tsx mandate/examples/local-demo.ts",
    "sdk:merchant": "node --import tsx mandate/examples/controlled-merchant.ts",
    "sdk:agent": "node --import tsx mandate/examples/minimal-agent.ts",
    "sdk:build": "pnpm build:upstream && pnpm m3:build:contracts && pnpm m4:build && pnpm m5:build:verifier && pnpm m6:build && pnpm typecheck",
    "setup:build": "node scripts/build-desktop-extension.mjs && pnpm m6:build",
    "setup:start": "node --import tsx mandate/onboarding/cli.ts",
    "setup:test": "vitest run --config mandate/onboarding/vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@x402/core": "workspace:*",
    "@x402/evm": "workspace:*",
    "fflate": "0.8.2",
    "smol-toml": "1.4.2",
    "viem": "2.48.11",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "ajv": "8.17.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
