{
  "schemaVersion": 2,
  "takeId": "formal-take-01",
  "seconds": 263.4,
  "captions": [
    {
      "start": 0.0,
      "end": 8.18,
      "text": "Mandate Wallet lets an AI agent purchase an approved API service within an owner-defined budget.",
      "chapter": "purpose"
    },
    {
      "start": 9.020000000000001,
      "end": 12.8,
      "text": "We will connect it to Claude Desktop,",
      "chapter": "purpose"
    },
    {
      "start": 13.18,
      "end": 17.4,
      "text": "obtain an ETH statistics sample, and produce a short brief.",
      "chapter": "purpose"
    },
    {
      "start": 18.18,
      "end": 21.86,
      "text": "The transactions in this demonstration run on Base Sepolia.",
      "chapter": "purpose"
    },
    {
      "start": 22.366666666666667,
      "end": 26.620000000000005,
      "text": "Prepare Claude Desktop, Rabby and Node twenty-four,",
      "chapter": "prerequisites"
    },
    {
      "start": 27.000000000000004,
      "end": 30.000000000000004,
      "text": "then start Mandate using the manual’s setup command.",
      "chapter": "prerequisites"
    },
    {
      "start": 30.820000000000004,
      "end": 34.08,
      "text": "The owner needs test ETH and USDC.",
      "chapter": "prerequisites"
    },
    {
      "start": 34.38,
      "end": 39.14,
      "text": "This demo uses controlled services and fixed statistics.",
      "chapter": "prerequisites"
    },
    {
      "start": 39.62666666666667,
      "end": 43.88666666666667,
      "text": "Choose Testnet and Base Sepolia in the setup wizard.",
      "chapter": "public-setup"
    },
    {
      "start": 44.42666666666667,
      "end": 49.02666666666667,
      "text": "Connect the owner wallet, then review deployment, funding and permissions.",
      "chapter": "public-setup"
    },
    {
      "start": 49.866666666666674,
      "end": 53.686666666666675,
      "text": "We transfer zero point one five test USDC to the smart account",
      "chapter": "public-setup"
    },
    {
      "start": 53.70666666666667,
      "end": 56.26666666666667,
      "text": "and fund operator gas separately.",
      "chapter": "public-setup"
    },
    {
      "start": 56.52666666666667,
      "end": 60.006666666666675,
      "text": "The task budget is zero point one five,",
      "chapter": "public-setup"
    },
    {
      "start": 60.28666666666667,
      "end": 63.26666666666667,
      "text": "each payment is capped at zero point one,",
      "chapter": "public-setup"
    },
    {
      "start": 63.40666666666667,
      "end": 66.64666666666668,
      "text": "and the session expires after two hours.",
      "chapter": "public-setup"
    },
    {
      "start": 67.16666666666667,
      "end": 70.26666666666667,
      "text": "The owner confirms these transactions in the external wallet.",
      "chapter": "public-setup"
    },
    {
      "start": 70.83999999999999,
      "end": 75.32,
      "text": "After confirmation, open the authorization transaction in BaseScan.",
      "chapter": "grant-explorer"
    },
    {
      "start": 75.75999999999999,
      "end": 79.92,
      "text": "Check the Base Sepolia network, transaction hash and successful receipt.",
      "chapter": "grant-explorer"
    },
    {
      "start": 80.75999999999999,
      "end": 84.03999999999999,
      "text": "The contract log links the session to the approved mandate.",
      "chapter": "grant-explorer"
    },
    {
      "start": 84.77999999999999,
      "end": 88.28,
      "text": "The complete hash will also appear in our execution evidence.",
      "chapter": "grant-explorer"
    },
    {
      "start": 88.72999999999999,
      "end": 92.78999999999999,
      "text": "Download the Guided package for this Base Sepolia configuration.",
      "chapter": "claude-install"
    },
    {
      "start": 94.00999999999999,
      "end": 98.41,
      "text": "In Claude Desktop, open Settings, Extensions and Advanced settings,",
      "chapter": "claude-install"
    },
    {
      "start": 99.13,
      "end": 101.41,
      "text": "then import and enable the package.",
      "chapter": "claude-install"
    },
    {
      "start": 102.10999999999999,
      "end": 108.27,
      "text": "Its local connection is already configured, so no Agent profile or Connection file is selected.",
      "chapter": "claude-install"
    },
    {
      "start": 109.05,
      "end": 111.95,
      "text": "Start a new conversation using this connection.",
      "chapter": "claude-install"
    },
    {
      "start": 112.33333333333333,
      "end": 115.49666666666666,
      "text": "Ask Claude to read the account context",
      "chapter": "context-quote"
    },
    {
      "start": 115.51666666666667,
      "end": 119.43666666666665,
      "text": "and quote the approved ETH sample without purchasing.",
      "chapter": "context-quote"
    },
    {
      "start": 120.15666666666665,
      "end": 123.73666666666666,
      "text": "Check the chain, account, active session and remaining budget.",
      "chapter": "context-quote"
    },
    {
      "start": 124.29666666666665,
      "end": 128.65666666666664,
      "text": "The sample costs zero point zero one test USDC.",
      "chapter": "context-quote"
    },
    {
      "start": 129.11666666666667,
      "end": 132.27666666666664,
      "text": "Installing the connector does not expand the approved authority.",
      "chapter": "context-quote"
    },
    {
      "start": 132.8,
      "end": 134.9233333333333,
      "text": "Authorize the quoted purchase.",
      "chapter": "purchase"
    },
    {
      "start": 135.58333333333331,
      "end": 141.0633333333333,
      "text": "Mandate registers the commitment before releasing a payment signature.",
      "chapter": "purchase"
    },
    {
      "start": 141.5233333333333,
      "end": 144.3433333333333,
      "text": "The USDC transfer settles on Base Sepolia,",
      "chapter": "purchase"
    },
    {
      "start": 144.86333333333332,
      "end": 148.7233333333333,
      "text": "but our controlled service deliberately fails its first response.",
      "chapter": "purchase"
    },
    {
      "start": 149.58333333333331,
      "end": 154.30333333333328,
      "text": "Claude reports payment, delivery and result validation separately.",
      "chapter": "purchase"
    },
    {
      "start": 155.0633333333333,
      "end": 159.0433333333333,
      "text": "A successful payment alone does not mean the data was delivered.",
      "chapter": "purchase"
    },
    {
      "start": 159.43333333333334,
      "end": 162.74666666666667,
      "text": "Open the settlement transaction in BaseScan.",
      "chapter": "payment-explorer"
    },
    {
      "start": 163.1866666666667,
      "end": 166.82666666666665,
      "text": "Check Success, the test USDC contract,",
      "chapter": "payment-explorer"
    },
    {
      "start": 167.0666666666667,
      "end": 171.16666666666669,
      "text": "and the ERC-twenty transfer from the smart account to the approved recipient",
      "chapter": "payment-explorer"
    },
    {
      "start": 171.18666666666667,
      "end": 174.82666666666665,
      "text": "for zero point zero one USDC.",
      "chapter": "payment-explorer"
    },
    {
      "start": 175.46666666666667,
      "end": 178.86666666666667,
      "text": "The transaction sender may be the facilitator paying gas;",
      "chapter": "payment-explorer"
    },
    {
      "start": 179.40666666666667,
      "end": 184.46666666666667,
      "text": "the token-transfer sender identifies the paying account.",
      "chapter": "payment-explorer"
    },
    {
      "start": 184.86666666666667,
      "end": 189.70999999999998,
      "text": "Claude resumes the same ETH step after checking its payment state.",
      "chapter": "recover-brief"
    },
    {
      "start": 190.21,
      "end": 194.67,
      "text": "The original order and settlement hash are retained, and there is no second payment.",
      "chapter": "recover-brief"
    },
    {
      "start": 195.07000000000002,
      "end": 199.31,
      "text": "The service returns the sample and the result checker validates it.",
      "chapter": "recover-brief"
    },
    {
      "start": 199.69000000000003,
      "end": 203.75,
      "text": "Claude writes a brief, identifies the fixed demonstration dataset,",
      "chapter": "recover-brief"
    },
    {
      "start": 204.17000000000002,
      "end": 205.39,
      "text": "and cites the settlement.",
      "chapter": "recover-brief"
    },
    {
      "start": 206.0066666666667,
      "end": 208.66666666666666,
      "text": "Claude prepares a revocation request.",
      "chapter": "revoke-explorer"
    },
    {
      "start": 209.42666666666668,
      "end": 213.70666666666668,
      "text": "The owner reviews it in the wallet workspace and signs in Rabby.",
      "chapter": "revoke-explorer"
    },
    {
      "start": 214.60666666666668,
      "end": 219.58666666666667,
      "text": "The BaseScan receipt and SessionRevoked log confirm the change.",
      "chapter": "revoke-explorer"
    },
    {
      "start": 220.10666666666668,
      "end": 225.40666666666667,
      "text": "Future spending by this session is blocked while the completed purchase remains recorded.",
      "chapter": "revoke-explorer"
    },
    {
      "start": 225.97333333333333,
      "end": 230.17333333333332,
      "text": "Finally, ask Claude to attempt the unused BTC sample.",
      "chapter": "refusal"
    },
    {
      "start": 230.69333333333333,
      "end": 233.2533333333333,
      "text": "The revoked session prevents a new payment registration.",
      "chapter": "refusal"
    },
    {
      "start": 234.25333333333333,
      "end": 239.4133333333333,
      "text": "This refusal has no new transaction hash because it is stopped before broadcast.",
      "chapter": "refusal"
    },
    {
      "start": 240.17333333333332,
      "end": 246.3733333333333,
      "text": "We retain the tool result, permission state and unchanged payment records as refusal evidence.",
      "chapter": "refusal"
    },
    {
      "start": 246.94,
      "end": 253.03999999999996,
      "text": "The evidence package connects each recorded step to its transaction, contract events and service outcome.",
      "chapter": "close"
    },
    {
      "start": 253.68,
      "end": 256.59999999999997,
      "text": "Payment and service delivery are documented separately.",
      "chapter": "close"
    },
    {
      "start": 257.23999999999995,
      "end": 259.38,
      "text": "A local practice option is also available",
      "chapter": "close"
    },
    {
      "start": 259.4,
      "end": 262.94,
      "text": "for learning the workflow without public-testnet funds.",
      "chapter": "close"
    }
  ],
