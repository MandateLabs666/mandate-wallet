      "start": 70.66666666666667,
      "end": 88.66666666666667,
      "purpose": "核对链上的授权结果",
      "screen": "向导确认交易 → BaseScan 交易详情及 SessionGranted 日志",
      "narration": "After confirmation, open the authorization transaction in BaseScan. Check the Base Sepolia network, transaction hash and successful receipt. The contract log links the session to the approved mandate. The complete hash will also appear in our execution evidence.",
      "viewSequence": [
        "workspace",
        "proof"
      ],
      "recording": "voice_for_video/Grant-explorer.m4a",
