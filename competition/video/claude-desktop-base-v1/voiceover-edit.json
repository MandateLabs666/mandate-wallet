  "chapters": [
    {
      "id": "purpose",
      "start": 0.0,
      "end": 22.366666666666667,
      "purpose": "说明任务及网络",
      "screen": "首页与案例目标；Base Sepolia 测试网标记",
      "narration": "Mandate Wallet lets an AI agent purchase an approved API service within an owner-defined budget. We will connect it to Claude Desktop, obtain an ETH statistics sample, and produce a short brief. The transactions in this demonstration run on Base Sepolia.",
      "viewSequence": [
        "workspace"
      ],
      "recording": "voice_for_video/purpose.m4a",
      "audioStart": 0.0,
      "audioEnd": 22.433333333333334,
      "voiceUnsped": true
    },
    {
      "id": "prerequisites",
      "start": 22.366666666666667,
      "end": 39.53333333333333,
      "purpose": "说明操作起点",
      "screen": "Claude Desktop、Node 24、外部 owner 钱包、Base Sepolia 测试资金",
      "narration": "Prepare Claude Desktop, Rabby and Node twenty-four, then start Mandate using the manual’s setup command. The owner needs test ETH and USDC. This demo uses controlled services and fixed statistics.",
      "viewSequence": [
        "workspace"
      ],
      "recording": "voice_for_video/Prerequisites.m4a",
      "audioStart": 22.3,
      "audioEnd": 39.6,
      "voiceUnsped": true
    },
    {
      "id": "public-setup",
      "start": 39.53333333333333,
      "end": 70.66666666666667,
      "purpose": "创建账户并批准有限权限",
      "screen": "Testnet → Base Sepolia → 外部钱包逐项审核账户部署、资金和授权",
      "narration": "Choose Testnet and Base Sepolia in the setup wizard. Connect the owner wallet, then review deployment, funding and permissions. We transfer zero point one five test USDC to the smart account and fund operator gas separately. The task budget is zero point one five, each payment is capped at zero point one, and the session expires after two hours. The owner confirms these transactions in the external wallet.",
      "viewSequence": [
        "workspace",
        "wallet",
        "workspace"
      ],
      "recording": "voice_for_video/Public-setup.m4a",
      "audioStart": 39.46666666666667,
      "audioEnd": 70.73333333333333,
      "voiceUnsped": true
    },
